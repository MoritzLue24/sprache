// TOKEN(kind, spelling, class)
// spelling is NULL for tokens without a fixed, single spelling (identifiers,
// literals, ...)
TOKEN(TK_END,     "", TC_OTHER)
TOKEN(TK_IDENT,   "", TC_OTHER)
TOKEN(TK_LITERAL, "", TC_OTHER)

TOKEN(TK_FUNC,   "fn",     TC_KW)
TOKEN(TK_VAR,    "var",     TC_KW)
TOKEN(TK_UINT8,  "uint8",     TC_KW)
TOKEN(TK_INT8,   "int8",     TC_KW)
TOKEN(TK_RETURN, "return", TC_KW)

TOKEN(TK_SEMICOLON, ";", TC_PUNCT)
TOKEN(TK_COMMA, ",", TC_PUNCT)
TOKEN(TK_COLON, ":", TC_PUNCT)
TOKEN(TK_ARROW, "->", TC_PUNCT)
TOKEN(TK_AT, "@", TC_PUNCT)
TOKEN(TK_LBRACE, "{", TC_PUNCT)
TOKEN(TK_RBRACE, "}", TC_PUNCT)

TOKEN(TK_EQ, "=", TC_PUNCT)
TOKEN(TK_LPAREN, "(", TC_PUNCT)
TOKEN(TK_RPAREN, ")", TC_PUNCT)

TOKEN(TK_PLUS, "+", TC_PUNCT)
TOKEN(TK_MINUS, "-", TC_PUNCT)
TOKEN(TK_STAR, "*", TC_PUNCT)
TOKEN(TK_BW_OR, "|", TC_PUNCT)
TOKEN(TK_BW_AND, "&", TC_PUNCT)
TOKEN(TK_BW_NOT, "~", TC_PUNCT)
TOKEN(TK_BW_XOR, "^", TC_PUNCT)

TOKEN(TK_EQEQ, "==", TC_PUNCT)
TOKEN(TK_NEQ, "!=", TC_PUNCT)
TOKEN(TK_LT, "<", TC_PUNCT)
TOKEN(TK_GT, ">", TC_PUNCT)
TOKEN(TK_LE, "<=", TC_PUNCT)
TOKEN(TK_GE, ">=", TC_PUNCT)

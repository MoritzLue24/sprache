#include "parser/parser.h"
#include "utils/arena.h"
#include "sprache/diag.h"
#include "utils/darray.h"
#include "diag/diag_internal.h"
#include <stddef.h>
#include <assert.h>
#include <stdarg.h>

enum SyncLevel {
    SYNC_TOPLEVEL,
    SYNC_STATEMENT,
    SYNC_PARAM,
};

struct Parser {
    struct Arena* a;
    const struct TokenList* tkl;
    struct DiagList* dl;
    size_t i;
    bool panic;
};

static struct Node* parse_func_def(struct Parser* p);
static struct NodeList parse_params(struct Parser* p);
static struct Node* parse_block(struct Parser* p);

static struct Token peek(const struct Parser* p);
static bool check(const struct Parser* p, enum TokenKind tk);
static struct Token advance(struct Parser* p);
static struct Token expect(struct Parser* p, enum TokenKind tk);

static void error(struct Parser* p, enum DiagCode code, ...);
static bool is_sync_unit_terminator(enum SyncLevel level, enum TokenKind tk);
static bool is_sync_stop(enum SyncLevel level, enum TokenKind tk);
static void sync(struct Parser* p, enum SyncLevel level);

// Error recovery, three layers with one job each:
//
//   error()     the only place that sets p->panic, and the only place that
//               calls diag_add. Never do either anywhere else.
//   grammar     signal failure with NULL / TK_INVALID only. They never
//               touch p->panic and never call sync().
//   collecting  parse() and parse_block(). They clear p->panic right
//   loops       before attempting a fresh item, and they are the only
//               callers of sync().
//
// Not written yet -- where the recovery bits belong once they exist:
//
//   parse_stmt()     dispatch only, no sync and no panic. Returns NULL and
//                    lets parse_block() recover.
//   parse_return()   expect(TK_RETURN), parse_expr(), then
//                    expect(TK_SEMICOLON) *without* checking the result: a
//                    missing separator is reported, but the node stays.
//   parse_var_decl() same shape, except a missing initialiser expression
//                    does return NULL -- there the meaning is gone, not
//                    just a separator.
//   parse_expr()     and everything below it never calls sync(). They
//                    propagate NULL upwards to the nearest collecting loop.
//   parse_factor()   the second place that calls error() directly, for
//                    "expected expression". Needs a new code in
//                    include/sprache/diag.def with a single %s.

struct Node parse(
    struct Arena* a, const struct TokenList* tkl, struct DiagList* dl
) {
    struct Parser p = { .a = a, .tkl = tkl, .dl = dl, .i = 0 };
    struct Node n_program;

    node_init(&n_program, NODE_PROGRAM, SOURCE_LOC_NULL, OP_INVALID, NULL);
    DARRAY_INIT(a, &n_program.program.nl, NODELIST_INIT_CAPACITY);

    while (!check(&p, TK_END)) {
        struct Node* n = NULL;

        switch (peek(&p).kind) {
            case TK_FUNC:
                // Solid ground: a fresh item starts here, so diagnostics
                // are allowed again.
                p.panic = false;
                n = parse_func_def(&p);
                break;
            default:
                // Nothing else starts a top-level item. Report it (the
                // panic flag collapses a whole run of junk into a single
                // message) and drop one token -- that is what guarantees
                // this loop makes progress.
                error(
                    &p, DIAG_UNEXPECTED_TOKEN, token_kind_str(TK_FUNC),
                    token_kind_str(peek(&p).kind)
                );
                advance(&p);
                continue;
        }

        if (n == NULL) {
            sync(&p, SYNC_TOPLEVEL);
            continue;
        }

        DARRAY_ADD(a, &n_program.program.nl, n);
    }
    return n_program;
}

static struct Node* parse_func_def(struct Parser* p)
{
    struct Token tk_kw = expect(p, TK_FUNC);
    if (tk_kw.kind == TK_INVALID) return NULL;

    struct Token tk_ident = expect(p, TK_IDENT);
    if (tk_ident.kind == TK_INVALID) return NULL;

    struct Node* n = ARENA_CALLOC(p->a, struct Node);
    node_init(n, NODE_FUNC_DEF, tk_kw.loc, OP_INVALID, tk_ident.value);

    if (expect(p, TK_LPAREN).kind == TK_INVALID) return NULL;
    n->func_def.params = parse_params(p);
    if (expect(p, TK_RPAREN).kind == TK_INVALID) return NULL;

    // TODO: Type
    // if (expect(p, TK_ARROW).kind == TK_INVALID) return NULL;

    n->func_def.body = parse_block(p);
    // A function without a usable body is not worth keeping: propagating
    // NULL sends parse() into sync(SYNC_TOPLEVEL), which skips to the next
    // 'fn'. Note this makes every function fail until parse_block() is
    // written -- that is correct, not a regression.
    if (n->func_def.body == NULL) return NULL;

    // No sync() anywhere in here: parse_func_def is not a collecting loop.
    // It only propagates NULL; recovery happens in parse() and, for the
    // body, in parse_block().
    return n;
}

static struct NodeList parse_params(struct Parser* p)
{
    struct NodeList params;
    DARRAY_INIT(p->a, &params, NODELIST_INIT_CAPACITY);

    if (check(p, TK_RPAREN)) return params;

    do {
        struct Token tk_ident = expect(p, TK_IDENT);

        if (tk_ident.kind != TK_INVALID) {
            struct Node* param = ARENA_CALLOC(p->a, struct Node);
            node_init(
                param, NODE_PARAM, tk_ident.loc, OP_INVALID, tk_ident.value
            );
            // TODO: ": <type>" per grammar.txt goes here. It needs no sync
            // of its own -- a failing expect() just falls through to the
            // sync(SYNC_PARAM) below.
            DARRAY_ADD(p->a, &params, param);
        }
        else {
            // SYNC_PARAM deliberately stops *before* the ',' instead of
            // consuming it, because the loop below relies on seeing it.
            // Progress is still guaranteed: either sync() ate the junk
            // token, or the advance() below eats the ','.
            sync(p, SYNC_PARAM);
        }

        if (check(p, TK_COMMA)) advance(p);
        else break;
    } while (true);

    return params;
}

static struct Node* parse_block(struct Parser* p)
{
    // NOT IMPLEMENTED. This is where the second collecting loop goes, and
    // the only other place that is allowed to call sync():
    //
    //   struct Token tk_lbrace = expect(p, TK_LBRACE);
    //   if (tk_lbrace.kind == TK_INVALID) return NULL;
    //
    //   struct Node* n = ARENA_CALLOC(p->a, struct Node);
    //   node_init(n, NODE_BLOCK, tk_lbrace.loc, OP_INVALID, NULL);
    //   DARRAY_INIT(p->a, &n->block.nl, NODELIST_INIT_CAPACITY);
    //
    //   // The condition must exit on every SYNC_STATEMENT stop token that
    //   // parse_stmt() does not consume by itself: TK_RBRACE, TK_FUNC,
    //   // TK_END. TK_LBRACE / TK_VAR / TK_RETURN need no exit here,
    //   // because parse_stmt()'s dispatch always eats them. Get this
    //   // wrong and sync() returns without consuming while the loop
    //   // retries the same token -- an endless loop.
    //   while (!check(p, TK_RBRACE) && !check(p, TK_FUNC)
    //       && !check(p, TK_END)) {
    //       p->panic = false;
    //       struct Node* stmt = parse_stmt(p);
    //       if (stmt == NULL) {
    //           sync(p, SYNC_STATEMENT);
    //           continue;
    //       }
    //       DARRAY_ADD(p->a, &n->block.nl, stmt);
    //   }
    //
    //   if (expect(p, TK_RBRACE).kind == TK_INVALID) return NULL;
    //   return n;
    (void)p;
    return NULL;
}

static struct Token peek(const struct Parser* p)
{
    if (p->i >= p->tkl->count) return p->tkl->items[p->tkl->count - 1];
    return p->tkl->items[p->i];
}

static bool check(const struct Parser* p, enum TokenKind tk)
{
    return peek(p).kind == tk;
}

static struct Token advance(struct Parser* p)
{
    struct Token tk = peek(p);
    if (p->i < p->tkl->count - 1) p->i++;
    return tk;
}

static struct Token expect(struct Parser* p, enum TokenKind tk)
{
    if (check(p, tk)) return advance(p);
    error(
        p, DIAG_UNEXPECTED_TOKEN, token_kind_str(tk),
        token_kind_str(peek(p).kind)
    );
    return TOKEN_NULL;
}

// NOTE: forwards to diag_vadd, not diag_add. C cannot pass '...' on to
// another variadic function, so the arguments have to travel as a va_list.
// The format itself stays bound to the code in "sprache/diag.def".
static void error(struct Parser* p, enum DiagCode code, ...)
{
    if (p->panic) return;
    p->panic = true;

    va_list args;
    va_start(args, code);
    diag_vadd(p->a, p->dl, code, peek(p).loc, args);
    va_end(args);
}

static bool is_sync_unit_terminator(enum SyncLevel level, enum TokenKind tk)
{
    switch (level) {
        case SYNC_TOPLEVEL: return false;
        case SYNC_STATEMENT: return tk == TK_SEMICOLON;
        // The ',' is *not* a terminator here -- parse_params() consumes it
        // itself, so sync() has to leave it in place.
        case SYNC_PARAM: return false;
    }
    return false;
}

static bool is_sync_stop(enum SyncLevel level, enum TokenKind tk)
{
    switch (level) {
        case SYNC_STATEMENT:
            return tk == TK_RBRACE || tk == TK_LBRACE || tk == TK_VAR
                || tk == TK_RETURN || tk == TK_FUNC;

        case SYNC_TOPLEVEL: return tk == TK_FUNC;

        case SYNC_PARAM:
            return tk == TK_COMMA || tk == TK_RPAREN || tk == TK_LBRACE
                || tk == TK_RBRACE || tk == TK_SEMICOLON || tk == TK_FUNC;
    }
    return false;
}

static void sync(struct Parser* p, enum SyncLevel level)
{
    p->panic = false;
    while (!check(p, TK_END)) {
        if (is_sync_stop(level, peek(p).kind)) return;

        bool terminator = is_sync_unit_terminator(level, peek(p).kind);
        advance(p);
        if (terminator) return;
    }
}
// BINOP(kind, tok, prec, assoc)
BINOP(OP_ASSIGN, TK_EQ, 1, ASSOC_RIGHT)
BINOP(OP_BW_OR, TK_BW_OR, 2, ASSOC_LEFT)
BINOP(OP_BW_XOR, TK_BW_XOR, 3, ASSOC_LEFT)
BINOP(OP_BW_AND, TK_BW_AND, 4, ASSOC_LEFT)
BINOP(OP_PLUS, TK_PLUS, 5, ASSOC_LEFT)
BINOP(OP_MINUS, TK_MINUS, 5, ASSOC_LEFT)
BINOP(OP_MUL, TK_STAR, 6, ASSOC_LEFT)